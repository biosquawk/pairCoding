FROM python:3.13.9-slim-bookworm@sha256:8cdd496996889eef0a8a7921c152c0a4a9f18a26c7a5e7257d3c90b431891894
COPY --chown=10001:10001 wheels/ /wheels/
COPY --chown=10001:10001 requirements.lock /requirements.lock
# No build RUN at all: hashed wheels unpack under bounded nonroot LSP startup in /tmp.
# No network, dependency resolver, host interpreter or persisted shared writable environment.
ENV HOME=/tmp XDG_CACHE_HOME=/tmp/cache PYTHONPATH=/tmp/pylsp PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /work
ENTRYPOINT []
