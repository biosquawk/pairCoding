{
  "all": true,
  "src": [
    "."
  ],
  "include": [
    "src/**",
    "scripts/**",
    "vite.config.ts",
    "java-puzzlers/prepare-tasks.mjs"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/*.d.mts",
    "**/*.d.cts",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "extension": [
    ".js",
    ".jsx",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".mts",
    ".cts"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "lcovonly",
    "json-summary",
    "json",
    "text-summary"
  ],
  "reports-dir": "coverage",
  "temp-directory": "coverage/tmp"
}
