diff --git a/next-runtime/runtime/src/test/java/io/thalamus/rebirth/runtime/NativeScopedCommandsTest.java b/next-runtime/runtime/src/test/java/io/thalamus/rebirth/runtime/NativeScopedCommandsTest.java
